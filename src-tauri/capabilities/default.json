{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window. Only the plugins we ship (§4.4) — no generic fs, shell or http plugin is exposed to the webview — plus our own app commands (allow-* entries, auto-generated from build.rs's APP_COMMANDS list; keep the two in sync).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "clipboard-manager:default",
    "log:default",
    "allow-library-create",
    "allow-library-open",
    "allow-library-info",
    "allow-library-close",
    "allow-recent-libraries",
    "allow-db-select",
    "allow-db-execute",
    "allow-db-batch",
    "allow-media-import-bytes",
    "allow-media-import-paths",
    "allow-media-import-begin",
    "allow-media-import-chunk",
    "allow-media-import-finish",
    "allow-media-reveal",
    "allow-media-purge",
    "allow-media-list-folder",
    "allow-cache-put",
    "allow-cache-has",
    "allow-cache-delete",
    "allow-backup-now",
    "allow-backup-list",
    "allow-backup-restore",
    "allow-app-paths",
    "allow-open-logs",
    "allow-dialog-save-file"
  ]
}
