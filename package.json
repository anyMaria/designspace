{
  "name": "designspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A private, local-first desktop app for visual inspiration.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench": "vite --open /?bench=10000",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "2.4.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-log": "2.10.0",
    "@tauri-apps/plugin-opener": "2.6.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "culori": "4.0.2",
    "d3-force": "3.0.0",
    "dompurify": "3.4.16",
    "jspdf": "4.2.1",
    "lucide-react": "1.48.0",
    "minisearch": "7.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pixi.js": "8.21.0",
    "rbush": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "ulid": "3.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tanstack/react-virtual": "3.14.13",
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/d3-force": "3.0.10",
    "@types/rbush": "4.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
